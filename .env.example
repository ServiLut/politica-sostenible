# Web (public values only)
NODE_ENV=production
DEPLOYMENT_PROFILE=production
# SHA Git completo e inmutable del commit que se construye.
APP_REVISION=replace-with-full-40-character-git-sha
ALLOW_INSECURE_DATABASE_CONNECTION=false
NEXT_PUBLIC_APP_URL=https://app.politicasostenible.co
NEXT_PUBLIC_SUPABASE_URL=https://storage.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
# Dockerfile raiz/Dokploy: API y web comparten contenedor.
# compose.production.yml sobrescribe este valor a http://api:4000.
NESTJS_API_URL=http://127.0.0.1:4000
# El stop timeout del orquestador debe superar este valor al menos 10 s
# (40 s cuando se conserva el valor predeterminado de 30000 ms).
SUPERVISOR_SHUTDOWN_GRACE_MS=30000

# API authentication and origin allowlist
JWT_SECRET=generate-a-different-unique-secret-with-openssl-rand-base64-32
CONSENT_IP_SALT=generate-an-independent-random-secret
# ID inmutable de un usuario ya creado por el servidor (hoy CUID; UUID también
# admitido). SAAS_ADMIN_EMAILS está retirado y su presencia bloquea el arranque.
SAAS_ADMIN_USER_IDS=replace-with-existing-user-uuid
# Genera una clave independiente con: openssl rand -base64 32
MFA_TOTP_ACTIVE_KEY_ID=key-2026-09
MFA_TOTP_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
# Usa migrate solo durante la transición confirmada desde secretos heredados.
# Cambia a reject tras verificar que no quede texto plano; los eventos
# MFA_SECRET_REENCRYPTED dejan evidencia de cada recifrado realizado.
MFA_TOTP_LEGACY_PLAINTEXT_MODE=migrate
# Rotación: conserva claves anteriores como JSON, sin la activa, hasta comprobar
# que no queden sobres con esos identificadores (el evento incluye sourceKeyId).
MFA_TOTP_PREVIOUS_KEYS=
CORS_ORIGINS=https://app.politicasostenible.co,https://www.politicasostenible.co

# PostgreSQL: pooled URL for runtime, direct URL obligatoria para migraciones.
# DIRECT_URL no puede usar pgbouncer, pool_mode=transaction ni el puerto 6543.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&sslmode=verify-full&schema=politica-sostenible
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full&schema=politica-sostenible
# Compatibilidad opcional de algunos proveedores; DIRECT_URL tiene prioridad.
# POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full&schema=politica-sostenible
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Falla rápido ante locks; eleva el timeout total sólo tras medir una copia real.
MIGRATION_LOCK_TIMEOUT_MS=10000
MIGRATION_STATEMENT_TIMEOUT_MS=900000

# Excepcion SOLO para una evaluacion sin datos personales ni operativos cuando el
# servidor PostgreSQL no ofrece TLS. Las seis variables deben cambiar juntas y el
# runtime deja una advertencia visible. Nunca uses este perfil en una operacion real:
# DEPLOYMENT_PROFILE=evaluation
# ALLOW_INSECURE_DATABASE_CONNECTION=true
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&sslmode=disable&schema=politica-sostenible
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable&schema=politica-sostenible
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Seed exclusivamente local (nunca habilitar en producción)
ALLOW_DEMO_SEED=false
SEED_ADMIN_EMAIL=admin@politica-sostenible.test
SEED_ADMIN_PASSWORD=replace-with-a-local-password-of-at-least-12-characters
SEED_ADMIN_DOCUMENT=DEV-ADMIN

# Supabase Storage only. Never expose the service role to the browser.
SUPABASE_URL=https://storage.example.com
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=politica-sostenible

# Observability. Add Redis + BullMQ only when a real background worker exists.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Límites del Compose separado; ajústalos sólo después de pruebas de carga.
MIGRATE_CPUS_LIMIT=1.0
MIGRATE_MEMORY_LIMIT=768m
MIGRATE_PIDS_LIMIT=256
API_CPUS_LIMIT=1.0
API_MEMORY_LIMIT=768m
API_PIDS_LIMIT=256
WEB_CPUS_LIMIT=0.75
WEB_MEMORY_LIMIT=512m
WEB_PIDS_LIMIT=256
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
