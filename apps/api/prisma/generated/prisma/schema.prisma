  @@index([tenantId, releaseId, votingDate, timeZone], map: "ElectoralCatalogEntry_tenant_release_votingDate_timeZone_idx")
}

/// Trabajo durable que enlaza una subida privada confirmada con la construccion
/// de un snapshot electoral. Redis transporta el trabajo; PostgreSQL conserva
/// la autoridad, la idempotencia y el resultado auditable por tenant.
model ElectoralCatalogImportJob {
  id                     String                       @id @default(cuid())
  tenantId               String
  clientRequestId        String                       @db.Uuid
  payloadSha256          String                       @db.Char(64)
  status                 ElectoralCatalogImportStatus @default(QUEUED)
  catalogKey             String                       @db.VarChar(160)
  sourceUrl              String                       @db.VarChar(2048)
  sourceDataset          String                       @db.VarChar(300)
  sourceCutoffAt         DateTime
  electionDate           DateTime                     @db.Date
  authorizationReference String                       @db.VarChar(500)
  licenseDeclaration     String                       @db.VarChar(500)
  sourceArtifactPath     String                       @db.VarChar(512)
  expectedContentSha256  String                       @db.Char(64)
  requestedById          String
  releaseId              String?
  attempts               Int                          @default(0)
  startedAt              DateTime?
  completedAt            DateTime?
  lastErrorCode          String?                      @db.VarChar(80)
  lastErrorMessage       String?                      @db.VarChar(1000)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  tenant                 Tenant                       @relation(fields: [tenantId], references: [id])
  requestedBy            User                         @relation("ElectoralCatalogImportRequester", fields: [requestedById, tenantId], references: [id, tenantId], map: "ElectoralCatalogImportJob_requestedBy_fkey")
  release                ElectoralCatalogRelease?     @relation("ElectoralCatalogImportRelease", fields: [releaseId, tenantId], references: [id, tenantId], map: "ElectoralCatalogImportJob_release_fkey")
  sourceObject           StoredObject                 @relation("ElectoralCatalogImportArtifact", fields: [tenantId, sourceArtifactPath], references: [tenantId, path], map: "ElectoralCatalogImportJob_sourceObject_fkey")

  @@unique([id, tenantId])
  @@unique([tenantId, clientRequestId], map: "ElectoralCatalogImportJob_tenant_clientRequestId_key")
  @@unique([tenantId, sourceArtifactPath], map: "ElectoralCatalogImportJob_tenant_sourceArtifactPath_key")
  @@index([tenantId, status, createdAt], map: "ElectoralCatalogImportJob_tenant_status_createdAt_idx")
  @@index([tenantId, requestedById, createdAt], map: "ElectoralCatalogImportJob_tenant_requestedBy_createdAt_idx")
  @@index([tenantId, releaseId], map: "ElectoralCatalogImportJob_tenant_releaseId_idx")
}

