  originalTextSummary    String                              @db.VarChar(3000)
  localDate              DateTime                            @db.Date
  localTime              String?                             @db.VarChar(5)
  timeZone               String                              @db.VarChar(100)
  occursAtUtc            DateTime?
  responsibleUserId      String?
  backupUserId           String?
  alertOffsetsDays       Int[]
  stageGateRequired      Boolean                             @default(false)
  resultEvidenceRequired Boolean                             @default(false)
  linkedTaskId           String?
  linkedEventId          String?
  createdAt              DateTime                            @default(now())
  tenant                 Tenant                              @relation(fields: [tenantId], references: [id], map: "ElectoralCalendarMilestone_tenant_fkey")
