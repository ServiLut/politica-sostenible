/// Tenant-scoped, versioned legal/calendar configuration for formal PQRSD.
/// A package is immutable once reviewed. Activation is protected by a partial
/// unique index and a four-eyes trigger in migration 20260909280000.
model PqrsdRulePackage {
  id                    String                     @id @default(cuid())
  tenantId              String
  scopeKey              String                     @db.VarChar(120)
  versionLabel          String                     @db.VarChar(80)
  sourceUrl             String                     @db.VarChar(2048)
  sourceReference       String                     @db.VarChar(500)
  sourceSha256          String                     @db.Char(64)
  timeZone              String                     @db.VarChar(100)
  effectiveFrom         DateTime                   @db.Date
  effectiveTo           DateTime?                  @db.Date
  nonWorkingWeekdays    Int[]
  computationMethodNote String                     @db.VarChar(1000)
  status                PqrsdRulePackageStatus     @default(DRAFT)
  revision              Int                        @default(1)
  createdById           String
  createdAt             DateTime                   @default(now())
  activatedAt           DateTime?
  tenant                Tenant                     @relation(fields: [tenantId], references: [id])
  createdBy             User                       @relation("PqrsdRulePackageCreator", fields: [createdById, tenantId], references: [id, tenantId])
  rules                 PqrsdRuleDefinition[]
  calendarExceptions    PqrsdCalendarException[]
  decisions             PqrsdRulePackageDecision[]
  dossiers              PqrsdDossier[]
  deadlines             PqrsdDeadlineVersion[]

  @@unique([id, tenantId])
  @@unique([tenantId, scopeKey, versionLabel])
  @@index([tenantId, scopeKey, status, effectiveFrom])
  @@index([tenantId, createdById, createdAt])
}

model PqrsdRuleDefinition {
  id                String                       @id @default(cuid())
  tenantId          String
  packageId         String
  classificationKey String                       @db.VarChar(120)
  label             String                       @db.VarChar(240)
  durationDays      Int
  dayMethod         PqrsdDayComputationMethod
  startRule         PqrsdTermStartRule
  legalBasis        String                       @db.VarChar(2000)
  highRisk          Boolean                      @default(false)
  createdAt         DateTime                     @default(now())
  tenant            Tenant                       @relation(fields: [tenantId], references: [id])
  package           PqrsdRulePackage             @relation(fields: [packageId, tenantId], references: [id, tenantId], onDelete: Cascade)
  classifications   PqrsdClassificationVersion[]
  deadlines         PqrsdDeadlineVersion[]

  @@unique([id, tenantId])
  @@unique([tenantId, packageId, classificationKey])
  @@index([tenantId, packageId])
}

model PqrsdCalendarException {
  id              String                     @id @default(cuid())
  tenantId        String
  packageId       String
  localDate       DateTime                   @db.Date
