/// Paquete inmutable de control interno para una eleccion y ronda concretas.
/// Su fuente puede ser oficial, pero ACTIVE significa solamente "vigente para
/// la operacion interna"; no certifica juridicamente ninguna fecha.
model ElectoralCalendarRelease {
  id                  String                             @id @db.Uuid
  tenantId            String
  operationProfileId  String
  initialCommandId    String                             @db.Uuid
  basedOnReleaseId    String?                            @db.Uuid
  electionType        ElectoralContestType
  electionDate        DateTime                           @db.Date
  circumscriptionType ElectoralCircumscriptionType
  circumscriptionName String                             @db.VarChar(160)
  circumscriptionCode String?                            @db.VarChar(64)
  roundCode           String                             @db.VarChar(64)
  versionLabel        String                             @db.VarChar(80)
  status              ElectoralCalendarReleaseStatus     @default(STAGED)
  sourceAuthority     String                             @db.VarChar(300)
  sourceUrl           String                             @db.VarChar(2048)
  sourceReference     String                             @db.VarChar(1000)
  sourcePublishedAt   DateTime                           @db.Date
  sourceCutoffAt      DateTime
  sourceSha256        String                             @db.Char(64)
  createdById         String
  validatedById       String?
  validatedAt         DateTime?
  activatedById       String?
  activatedAt         DateTime?
  supersededAt        DateTime?
  version             Int                                @default(1)
  createdAt           DateTime                           @default(now())
  updatedAt           DateTime                           @updatedAt
  tenant              Tenant                             @relation(fields: [tenantId], references: [id], map: "ElectoralCalendarRelease_tenant_fkey")
  operationProfile    OperationProfile                   @relation(fields: [operationProfileId, tenantId], references: [id, tenantId], map: "ElectoralCalendarRelease_profile_fkey")
  initialCommand      ElectoralCalendarCommand           @relation("CalendarReleaseInitialCommand", fields: [initialCommandId, tenantId], references: [id, tenantId], map: "ElectoralCalendarRelease_command_fkey")
  basedOnRelease      ElectoralCalendarRelease?          @relation("ElectoralCalendarSupersession", fields: [basedOnReleaseId, tenantId], references: [id, tenantId], map: "ElectoralCalendarRelease_based_on_fkey")
  derivedReleases     ElectoralCalendarRelease[]         @relation("ElectoralCalendarSupersession")
  createdBy           User                               @relation("ElectoralCalendarReleaseCreator", fields: [createdById, tenantId], references: [id, tenantId], map: "ElectoralCalendarRelease_creator_fkey")
  validatedBy         User?                              @relation("ElectoralCalendarReleaseValidator", fields: [validatedById, tenantId], references: [id, tenantId], map: "ElectoralCalendarRelease_validator_fkey")
  activatedBy         User?                              @relation("ElectoralCalendarReleaseActivator", fields: [activatedById, tenantId], references: [id, tenantId], map: "ElectoralCalendarRelease_activator_fkey")
  milestones          ElectoralCalendarMilestone[]
  decisions           ElectoralCalendarReleaseDecision[]
  results             ElectoralCalendarMilestoneResult[]

  @@unique([id, tenantId], map: "ElectoralCalendarRelease_id_tenant_key")
  @@unique([initialCommandId, tenantId], map: "ElectoralCalendarRelease_command_tenant_key")
  @@unique([tenantId, operationProfileId, electionType, electionDate, roundCode, versionLabel], map: "ElectoralCalendarRelease_version_scope_key")
  @@index([tenantId, operationProfileId, roundCode, status], map: "ElectoralCalendarRelease_scope_status_idx")
  @@index([tenantId, sourceSha256], map: "ElectoralCalendarRelease_source_hash_idx")
}

/// Fecha civil conservada tal como fue interpretada por el operador. La hora
