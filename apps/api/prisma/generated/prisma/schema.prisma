  @@unique([id, tenantId])
  @@index([tenantId, dossierId, occurredAt])
}

/// Idempotency ledger. payloadSha256 hashes canonical JSON, never raw files or
/// petitioner content. The result snapshot contains identifiers/state only.
model PqrsdCommand {
  id             String           @id @default(cuid())
  tenantId       String
  commandId      String           @db.Uuid
  commandType    PqrsdCommandType
  payloadSha256  String           @db.Char(64)
  resultSnapshot Json
  actorId        String
  versionBefore  Int?
  versionAfter   Int?
  createdAt      DateTime         @default(now())
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  actor          User             @relation("PqrsdCommandActor", fields: [actorId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@unique([tenantId, commandId])
  @@index([tenantId, commandType, createdAt])
  @@index([tenantId, actorId, createdAt])
}

