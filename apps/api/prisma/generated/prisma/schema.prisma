  @@unique([id, tenantId], map: "SignatureCountCorrectionDecision_id_tenant_key")
  @@unique([proposalId, tenantId], map: "SignatureCountCorrectionDecision_proposal_tenant_key")
  @@unique([commandId, tenantId], map: "SignatureCountCorrectionDecision_command_tenant_key")
  @@index([tenantId, reviewedById, createdAt], map: "SignatureCountCorrectionDecision_tenant_reviewer_created_idx")
}

