  @@unique([id, tenantId])
  @@unique([tenantId, type, sourceDataset, contentSha256, parserVersion], map: "ElectoralCatalogRelease_idempotency_key")
  @@index([tenantId, catalogKey, status], map: "ElectoralCatalogRelease_tenant_catalog_status_idx")
  @@index([tenantId, type, status], map: "ElectoralCatalogRelease_tenant_type_status_idx")
  @@index([tenantId, electionDate], map: "ElectoralCatalogRelease_tenant_electionDate_idx")
  @@index([tenantId, createdAt], map: "ElectoralCatalogRelease_tenant_createdAt_idx")
}

/// Unidad jerarquica de un release. `expectedTables` es solo un conteo del
