generator client {
  provider        = "prisma-client-js"
  output          = "./generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model Tenant {
  id                                String                                @id @default(cuid())
  slug                              String                                @unique
  name                              String
  type                              TenantType                            @default(CANDIDACY)
  defaultMode                       PoliticalOperationMode                @default(CAMPAIGN)
  config                            Json?
  parentTenantId                    String?
  parent                            Tenant?                               @relation("TenantHierarchy", fields: [parentTenantId], references: [id])
  children                          Tenant[]                              @relation("TenantHierarchy")
  createdAt                         DateTime                              @default(now())
  updatedAt                         DateTime                              @updatedAt
  settings                          CampaignSettings?
  users                             User[]
  divisions                         PoliticalDivision[]                   @relation("TenantDivisions")
  territoryLeaders                  TerritoryLeader[]
  voters                            Voter[]
  finances                          FinancialEntry[]
  witnesses                         WitnessReport[]
  events                            CampaignEvent[]
  pointLogs                         PointLog[]
  inventory                         InventoryItem[]
  inventoryMovements                InventoryMovement[]
  inventoryWarehouses               InventoryWarehouse[]
  inventoryStockBalances            InventoryStockBalance[]
  inventoryTransfers                InventoryTransfer[]
  inventoryTransferLines            InventoryTransferLine[]
  inventoryCustodyEvents            InventoryCustodyEvent[]
  inventoryIncidents                InventoryIncident[]
  inventoryCommands                 InventoryCommand[]
  consentRecords                    ConsentRecord[]
  consentNotices                    ConsentNotice[]
  issueCases                        IssueCase[]
  interactions                      Interaction[]
  tasks                             Task[]
  commitments                       Commitment[]
  communicationApprovals            CommunicationApproval[]
  teamInvitations                   TeamInvitation[]
  auditEvents                       AuditEvent[]
  storedObjects                     StoredObject[]
  operationProfile                  OperationProfile?
  politicalProposals                PoliticalProposal[]
  subscription                      TenantSubscription?
  electronicSignatures              ElectronicSignature[]
  offlineSyncReceipts               OfflineSyncReceipt[]
  electoralCatalogReleases          ElectoralCatalogRelease[]
  electoralCatalogEntries           ElectoralCatalogEntry[]
  electoralCatalogImports           ElectoralCatalogImportJob[]
  operationStageAdoptions           OperationStageAdoptionRequest[]
  operationTerminations             OperationTerminationRequest[]
  offlineE14CaptureGrants           OfflineE14CaptureGrant[]
  retentionDispositions             RetentionDispositionRequest[]
  retentionLegalHolds               RetentionLegalHold[]
  retentionHoldRevocations          RetentionLegalHoldRevocation[]
  witnessAssignments                WitnessAssignment[]
  witnessCoverageWindows            WitnessCoverageWindow[]
  witnessCoverageCommands           WitnessCoverageWindowCommand[]
  signatureCollectionPlans          SignatureCollectionPlan[]
  signatureCollectionBatches        SignatureCollectionBatch[]
  signatureCollectionCommands       SignatureCollectionCommand[]
  signatureCustodyEvents            SignatureCustodyEvent[]
  signatureAuthorityResults         SignatureAuthorityResult[]
  signatureAuthorityReviews         SignatureAuthorityResultReview[]
  signatureCountCorrectionCommands  SignatureCountCorrectionCommand[]
  signatureCountCorrectionProposals SignatureCountCorrectionProposal[]
  signatureCountCorrectionDecisions SignatureCountCorrectionDecision[]
  scrutinyCommissions               ScrutinyCommission[]
  scrutinyRequirements              ScrutinyDocumentRequirement[]
  scrutinyCommissionEvents          ScrutinyCommissionEvent[]
  scrutinyDocuments                 ScrutinyDocument[]
  scrutinyCommissionCoverage        ScrutinyCommissionCoverage[]
  scrutinyCustodyEvents             ScrutinyCustodyEvent[]
  scrutinyDiscrepancies             ScrutinyDiscrepancy[]
  scrutinyActions                   ScrutinyAction[]
  scrutinyActionVersions            ScrutinyActionVersion[]
  scrutinyActionDecisions           ScrutinyActionDecision[]
  scrutinyDeclarations              ScrutinyDeclaration[]
  scrutinyResultLines               ScrutinyDeclaredResultLine[]
  scrutinyCommands                  ScrutinyCommand[]
  financeReportDossiers             FinanceReportDossier[]
  financeLedgerCuts                 FinanceLedgerCut[]
  financeLedgerCutLines             FinanceLedgerCutLine[]
  financeReportVersions             FinanceReportVersion[]
  financeReportApprovals            FinanceReportApproval[]
  financeBankStatements             FinanceBankStatement[]
  financeBankStatementLines         FinanceBankStatementLine[]
  financeInKindContributions        FinanceInKindContribution[]
  financePayables                   FinancePayable[]
  financePayableSettlements         FinancePayableSettlement[]
  financeExternalEvidence           FinanceExternalFilingEvidence[]
  financeExternalReviews            FinanceExternalFilingEvidenceReview[]
  financeCommands                   FinanceCloseoutCommand[]
  electoralCalendarReleases         ElectoralCalendarRelease[]
  electoralCalendarMilestones       ElectoralCalendarMilestone[]
  electoralCalendarDecisions        ElectoralCalendarReleaseDecision[]
  electoralCalendarResults          ElectoralCalendarMilestoneResult[]
  electoralCalendarReviews          ElectoralCalendarResultReview[]
  electoralCalendarCommands         ElectoralCalendarCommand[]
  pqrsdRulePackages                 PqrsdRulePackage[]
  pqrsdRuleDefinitions              PqrsdRuleDefinition[]
  pqrsdCalendarExceptions           PqrsdCalendarException[]
  pqrsdRuleDecisions                PqrsdRulePackageDecision[]
  pqrsdDossiers                     PqrsdDossier[]
  pqrsdPetitioners                  PqrsdPetitionerSnapshot[]
  pqrsdDocuments                    PqrsdDocument[]
  pqrsdDocumentReviews              PqrsdDocumentReview[]
  pqrsdAcknowledgements             PqrsdReceiptAcknowledgement[]
  pqrsdDetailAccesses               PqrsdDetailAccess[]
  pqrsdClassifications              PqrsdClassificationVersion[]
  pqrsdClassificationReviews        PqrsdClassificationReview[]
  pqrsdDeadlines                    PqrsdDeadlineVersion[]
  pqrsdAssignments                  PqrsdAssignmentEvent[]
  pqrsdTransfers                    PqrsdTransfer[]
  pqrsdTransferReviews              PqrsdTransferReview[]
  pqrsdTransferAttempts             PqrsdTransferAttempt[]
  pqrsdExtensions                   PqrsdExtensionProposal[]
  pqrsdExtensionReviews             PqrsdExtensionReview[]
  pqrsdResponseVersions             PqrsdResponseVersion[]
  pqrsdResponseReviews              PqrsdResponseReview[]
  pqrsdAuthorizations               PqrsdResponseAuthorization[]
  pqrsdDeliveryAttempts             PqrsdDeliveryAttempt[]
  pqrsdClosures                     PqrsdClosure[]
  pqrsdReopenings                   PqrsdReopening[]
  pqrsdStatusEvents                 PqrsdStatusEvent[]
  pqrsdCommands                     PqrsdCommand[]
  transitionHandoverReports         TransitionHandoverReport[]

  @@index([parentTenantId])
}

model CampaignSettings {
  id                       String              @id @default(cuid())
  tenantId                 String              @unique
  maxTotalBudget           Decimal             @db.Decimal(15, 2)
  maxPublicityLimit        Decimal             @db.Decimal(15, 2)
  electionName             String?             @db.VarChar(200)
  electionDate             DateTime?
  reportScope              FinanceReportScope?
  officialLimitsReference  String?             @db.VarChar(250)
  officialLimitsUrl        String?             @db.VarChar(2048)
  reportDeadline           DateTime?
  financialManagerName     String?             @db.VarChar(200)
  financialManagerDocument String?             @db.VarChar(32)
  accountantName           String?             @db.VarChar(200)
  accountantDocument       String?             @db.VarChar(32)
  uniqueAccountBank        String?             @db.VarChar(160)
  uniqueAccountLastFour    String?             @db.Char(4)
  cuentasClarasCode        String?             @db.VarChar(120)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  tenant                   Tenant              @relation(fields: [tenantId], references: [id])
}

model StoredObject {
  id                             String                            @id @default(cuid())
  tenantId                       String
  uploaderId                     String
  path                           String                            @unique @db.VarChar(512)
  module                         StorageObjectModule
  contentType                    String                            @db.VarChar(150)
  expectedSize                   Int
  actualSize                     Int?
  etag                           String?                           @db.VarChar(255)
  expectedSha256                 String?                           @db.Char(64)
  reportedSha256                 String?                           @db.Char(64)
  integrityStatus                StorageIntegrityStatus            @default(NOT_PROVIDED)
  calculatedSha256               String?                           @db.Char(64)
  observedSize                   Int?
  observedContentType            String?                           @db.VarChar(150)
  integrityCheckedAt             DateTime?
  integrityVerifiedAt            DateTime?
  integrityFailureCode           String?                           @db.VarChar(64)
  integrityVerificationAttempts  Int                               @default(0)
  integrityVerificationStartedAt DateTime?
  integrityVerificationLeaseId   String?                           @db.Uuid
  status                         StoredObjectStatus                @default(ISSUED)
  expiresAt                      DateTime
  confirmedAt                    DateTime?
  consumedAt                     DateTime?
  consumedByType                 String?                           @db.VarChar(64)
  consumedById                   String?                           @db.VarChar(128)
  documentCategory               DocumentCategory?
  retentionPhase                 RetentionPhase                    @default(MANAGEMENT)
  createdAt                      DateTime                          @default(now())
  updatedAt                      DateTime                          @updatedAt
  tenant                         Tenant                            @relation(fields: [tenantId], references: [id])
  uploader                       User                              @relation("StoredObjectUploader", fields: [uploaderId, tenantId], references: [id, tenantId])
  signatures                     ElectronicSignature[]
  catalogImportJob               ElectoralCatalogImportJob?        @relation("ElectoralCatalogImportArtifact")
  scrutinyDocument               ScrutinyDocument?
  financeBankStatement           FinanceBankStatement?
  financeInKindContribution      FinanceInKindContribution?
  financePayable                 FinancePayable?
  financePayableSettlement       FinancePayableSettlement?
  pqrsdDocument                  PqrsdDocument?
  financeExternalFilingEvidence  FinanceExternalFilingEvidence?
  electoralCalendarResult        ElectoralCalendarMilestoneResult?
  signatureCountCorrection       SignatureCountCorrectionProposal?

  @@unique([id, tenantId])
  @@unique([tenantId, path])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, integrityStatus, integrityVerificationStartedAt])
  @@index([tenantId, integrityStatus, createdAt, id])
  @@index([tenantId, uploaderId, id])
  @@index([tenantId, uploaderId, createdAt])
  @@index([tenantId, module, consumedAt])
}

model User {
  id                                 String                                @id @default(cuid())
  email                              String                                @unique
  password                           String
  authVersion                        Int                                   @default(0)
  mustChangePassword                 Boolean                               @default(false)
  temporaryPasswordExpiresAt         DateTime?
  name                               String
  role                               Role                                  @default(VOLUNTEER)
  isActive                           Boolean                               @default(true)
  documentId                         String?
  phone                              String?
  totpSecret                         String? /// Encrypted TOTP secret (null = MFA not enabled)
  totpEnabledAt                      DateTime? /// When MFA was enabled
  lastTotpTimeStep                   Int? /// Last atomically consumed RFC 6238 time step
  points                             Int                                   @default(0)
  tenantId                           String
  divisionId                         String?
  createdAt                          DateTime                              @default(now())
  updatedAt                          DateTime                              @updatedAt
  tenant                             Tenant                                @relation(fields: [tenantId], references: [id])
  division                           PoliticalDivision?                    @relation(fields: [divisionId, tenantId], references: [id, tenantId])
  financialEntriesReported           FinancialEntry[]                      @relation("FinancialEntryReporter")
  financialEntriesReviewed           FinancialEntry[]                      @relation("FinancialEntryReviewer")
  financialEntriesCneMarked          FinancialEntry[]                      @relation("FinancialEntryCneMarker")
  registeredVoters                   Voter[]                               @relation("Registrar")
  witnessReports                     WitnessReport[]                       @relation("WitnessReportReporter")
  witnessReportsReviewed             WitnessReport[]                       @relation("WitnessReportReviewer")
  consentsCaptured                   ConsentRecord[]                       @relation("ConsentCapturedBy")
  consentNoticesCreated              ConsentNotice[]                       @relation("ConsentNoticeCreatedBy")
  casesAssigned                      IssueCase[]                           @relation("CaseAssignee")
  casesCreated                       IssueCase[]                           @relation("CaseCreatedBy")
  interactions                       Interaction[]                         @relation("InteractionActor")
  tasksAssigned                      Task[]                                @relation("TaskAssignee")
  tasksCreated                       Task[]                                @relation("TaskCreator")
  commitmentsOwned                   Commitment[]                          @relation("CommitmentOwner")
  communicationsRequested            CommunicationApproval[]               @relation("CommunicationRequestedBy")
  communicationsDecided              CommunicationApproval[]               @relation("CommunicationDecidedBy")
  invitationsSent                    TeamInvitation[]                      @relation("InvitationInviter")
  eventsResponsible                  CampaignEvent[]                       @relation("EventResponsible")
  pointLogs                          PointLog[]
  inventoryMoves                     InventoryMovement[]                   @relation("InventoryMovementActor")
  inventoryMovesFrom                 InventoryMovement[]                   @relation("InventoryMovementCustodyFrom")
  inventoryMovesTo                   InventoryMovement[]                   @relation("InventoryMovementCustodyTo")
  inventoryWarehousesManaged         InventoryWarehouse[]                  @relation("InventoryWarehouseResponsible")
  inventoryWarehousesCreated         InventoryWarehouse[]                  @relation("InventoryWarehouseCreatedBy")
  inventoryItemsCreated              InventoryItem[]                       @relation("InventoryItemCreatedBy")
  inventoryStocksResponsible         InventoryStockBalance[]               @relation("InventoryStockResponsible")
  inventoryTransfersCustodied        InventoryTransfer[]                   @relation("InventoryTransferCustodian")
  inventoryTransfersDispatched       InventoryTransfer[]                   @relation("InventoryTransferDispatchedBy")
  inventoryTransfersReconciled       InventoryTransfer[]                   @relation("InventoryTransferReconciledBy")
  inventoryCustodyEventsActed        InventoryCustodyEvent[]               @relation("InventoryCustodyEventActor")
  inventoryCustodyEventsFrom         InventoryCustodyEvent[]               @relation("InventoryCustodyEventFrom")
  inventoryCustodyEventsTo           InventoryCustodyEvent[]               @relation("InventoryCustodyEventTo")
  inventoryIncidentsReported         InventoryIncident[]                   @relation("InventoryIncidentReportedBy")
  inventoryCommands                  InventoryCommand[]                    @relation("InventoryCommandActor")
  auditEvents                        AuditEvent[]                          @relation("AuditActor")
  storedObjects                      StoredObject[]                        @relation("StoredObjectUploader")
  operationProfilesResponsible       OperationProfile[]                    @relation("OperationProfileResponsible")
  operationProfilesCreated           OperationProfile[]                    @relation("OperationProfileCreatedBy")
  operationProfilesUpdated           OperationProfile[]                    @relation("OperationProfileUpdatedBy")
  proposalsOwned                     PoliticalProposal[]                   @relation("ProposalOwner")
  proposalsCreated                   PoliticalProposal[]                   @relation("ProposalCreatedBy")
  proposalsUpdated                   PoliticalProposal[]                   @relation("ProposalUpdatedBy")
  electronicSignatures               ElectronicSignature[]
  offlineSyncReceipts                OfflineSyncReceipt[]                  @relation("OfflineSyncActor")
  electoralCatalogsCreated           ElectoralCatalogRelease[]             @relation("ElectoralCatalogCreatedBy")
  electoralCatalogsValidated         ElectoralCatalogRelease[]             @relation("ElectoralCatalogValidatedBy")
  electoralCatalogsActivated         ElectoralCatalogRelease[]             @relation("ElectoralCatalogActivatedBy")
  electoralCatalogsApproved          ElectoralCatalogRelease[]             @relation("ElectoralCatalogApprovedBy")
  electoralCatalogImports            ElectoralCatalogImportJob[]           @relation("ElectoralCatalogImportRequester")
  operationAdoptionsRequested        OperationStageAdoptionRequest[]       @relation("OperationAdoptionRequestedBy")
  operationAdoptionsReviewed         OperationStageAdoptionRequest[]       @relation("OperationAdoptionReviewedBy")
  operationAdoptionsResponsible      OperationStageAdoptionRequest[]       @relation("OperationAdoptionResponsible")
  operationTerminationsRequested     OperationTerminationRequest[]         @relation("OperationTerminationRequestedBy")
  operationTerminationsReviewed      OperationTerminationRequest[]         @relation("OperationTerminationReviewedBy")
  operationTerminationsCancelled     OperationTerminationRequest[]         @relation("OperationTerminationCancelledBy")
  offlineE14CaptureGrants            OfflineE14CaptureGrant[]              @relation("OfflineE14GrantActor")
  retentionDispositionsRequested     RetentionDispositionRequest[]         @relation("RetentionDispositionRequestedBy")
  retentionDispositionsReviewed      RetentionDispositionRequest[]         @relation("RetentionDispositionReviewedBy")
  retentionDispositionsCancelled     RetentionDispositionRequest[]         @relation("RetentionDispositionCancelledBy")
  retentionLegalHoldsCreated         RetentionLegalHold[]                  @relation("RetentionLegalHoldCreatedBy")
  retentionHoldRevocationsCreated    RetentionLegalHoldRevocation[]        @relation("RetentionLegalHoldRevokedBy")
  witnessAssignments                 WitnessAssignment[]                   @relation("WitnessAssignmentWitness")
  witnessAssignmentsCreated          WitnessAssignment[]                   @relation("WitnessAssignmentCreatedBy")
  witnessAssignmentsConfirmed        WitnessAssignment[]                   @relation("WitnessAssignmentConfirmedBy")
  witnessAssignmentsCancelled        WitnessAssignment[]                   @relation("WitnessAssignmentCancelledBy")
  witnessCoverageWindowsCreated      WitnessCoverageWindow[]               @relation("WitnessCoverageWindowCreatedBy")
  witnessCoverageWindowsUpdated      WitnessCoverageWindow[]               @relation("WitnessCoverageWindowUpdatedBy")
  witnessCoverageWindowCommands      WitnessCoverageWindowCommand[]        @relation("WitnessCoverageWindowCommandActor")
  signaturePlansOwned                SignatureCollectionPlan[]             @relation("SignaturePlanFileOwner")
  signaturePlansCustodied            SignatureCollectionPlan[]             @relation("SignaturePlanCustodyOwner")
  signaturePlansCreated              SignatureCollectionPlan[]             @relation("SignaturePlanCreatedBy")
  signatureCollectionCommands        SignatureCollectionCommand[]          @relation("SignatureCollectionCommandActor")
  signatureBatchesCustodied          SignatureCollectionBatch[]            @relation("SignatureBatchCustodian")
  signatureCustodyEventsActed        SignatureCustodyEvent[]               @relation("SignatureCustodyEventActor")
  signatureCustodyEventsReceived     SignatureCustodyEvent[]               @relation("SignatureCustodyEventReceiver")
  signatureAuthorityResultsRecorded  SignatureAuthorityResult[]            @relation("SignatureAuthorityResultRecorder")
  signatureAuthorityReviewsMade      SignatureAuthorityResultReview[]      @relation("SignatureAuthorityResultReviewer")
  signatureCountCorrectionCommands   SignatureCountCorrectionCommand[]     @relation("SignatureCountCorrectionCommandActor")
  signatureCountCorrectionsRequested SignatureCountCorrectionProposal[]    @relation("SignatureCountCorrectionRequester")
  signatureCountCorrectionsReviewed  SignatureCountCorrectionDecision[]    @relation("SignatureCountCorrectionReviewer")
  scrutinyCommissionsLed             ScrutinyCommission[]                  @relation("ScrutinyCommissionLegalLead")
  scrutinyCommissionsCreated         ScrutinyCommission[]                  @relation("ScrutinyCommissionCreator")
  scrutinyRequirementsDeclared       ScrutinyDocumentRequirement[]         @relation("ScrutinyRequirementDeclarer")
  scrutinySessionEvents              ScrutinyCommissionEvent[]             @relation("ScrutinyCommissionEventActor")
  scrutinyDocumentsCreated           ScrutinyDocument[]                    @relation("ScrutinyDocumentCreator")
  scrutinyDocumentsReviewed          ScrutinyDocument[]                    @relation("ScrutinyDocumentReviewer")
  scrutinyCoverageAssigned           ScrutinyCommissionCoverage[]          @relation("ScrutinyCoverageWitness")
  scrutinyCoverageCreated            ScrutinyCommissionCoverage[]          @relation("ScrutinyCoverageCreator")
  scrutinyCustodyEvents              ScrutinyCustodyEvent[]                @relation("ScrutinyCustodyEventActor")
  scrutinyDiscrepanciesResponsible   ScrutinyDiscrepancy[]                 @relation("ScrutinyDiscrepancyResponsible")
  scrutinyDiscrepanciesCreated       ScrutinyDiscrepancy[]                 @relation("ScrutinyDiscrepancyCreator")
  scrutinyDiscrepanciesResolved      ScrutinyDiscrepancy[]                 @relation("ScrutinyDiscrepancyResolver")
  scrutinyActionsDrafted             ScrutinyAction[]                      @relation("ScrutinyActionDrafter")
  scrutinyActionsApproved            ScrutinyAction[]                      @relation("ScrutinyActionApprover")
  scrutinyActionsFiled               ScrutinyAction[]                      @relation("ScrutinyActionFiler")
  scrutinyActionVersionsCreated      ScrutinyActionVersion[]               @relation("ScrutinyActionVersionCreator")
  scrutinyDecisionsRecorded          ScrutinyActionDecision[]              @relation("ScrutinyDecisionRecorder")
  scrutinyDecisionsReviewed          ScrutinyActionDecision[]              @relation("ScrutinyDecisionReviewer")
  scrutinyDeclarationsRecorded       ScrutinyDeclaration[]                 @relation("ScrutinyDeclarationRecorder")
  scrutinyDeclarationsReviewed       ScrutinyDeclaration[]                 @relation("ScrutinyDeclarationReviewer")
  scrutinyCommands                   ScrutinyCommand[]                     @relation("ScrutinyCommandActor")
  financeDossiersCreated             FinanceReportDossier[]                @relation("FinanceDossierCreator")
  financeCutsCreated                 FinanceLedgerCut[]                    @relation("FinanceLedgerCutCreator")
  financeVersionsCreated             FinanceReportVersion[]                @relation("FinanceReportVersionCreator")
  financeApprovalsMade               FinanceReportApproval[]               @relation("FinanceReportApprover")
  financeStatementsCreated           FinanceBankStatement[]                @relation("FinanceBankStatementCreator")
  financeInKindCreated               FinanceInKindContribution[]           @relation("FinanceInKindCreator")
  financePayablesCreated             FinancePayable[]                      @relation("FinancePayableCreator")
  financeSettlementsCreated          FinancePayableSettlement[]            @relation("FinancePayableSettlementCreator")
  financeExternalEvidenceRecorded    FinanceExternalFilingEvidence[]       @relation("FinanceExternalEvidenceRecorder")
  financeExternalEvidenceReviewed    FinanceExternalFilingEvidenceReview[] @relation("FinanceExternalEvidenceReviewer")
  financeCloseoutCommands            FinanceCloseoutCommand[]              @relation("FinanceCloseoutCommandActor")
  electoralCalendarsCreated          ElectoralCalendarRelease[]            @relation("ElectoralCalendarReleaseCreator")
  electoralCalendarsValidated        ElectoralCalendarRelease[]            @relation("ElectoralCalendarReleaseValidator")
  electoralCalendarsActivated        ElectoralCalendarRelease[]            @relation("ElectoralCalendarReleaseActivator")
  electoralCalendarMilestonesOwned   ElectoralCalendarMilestone[]          @relation("ElectoralCalendarMilestoneOwner")
  electoralCalendarMilestonesBacked  ElectoralCalendarMilestone[]          @relation("ElectoralCalendarMilestoneBackup")
  electoralCalendarDecisionsMade     ElectoralCalendarReleaseDecision[]    @relation("ElectoralCalendarDecisionActor")
  electoralCalendarResultsRecorded   ElectoralCalendarMilestoneResult[]    @relation("ElectoralCalendarResultRecorder")
  electoralCalendarReviewsMade       ElectoralCalendarResultReview[]       @relation("ElectoralCalendarResultReviewer")
  electoralCalendarCommands          ElectoralCalendarCommand[]            @relation("ElectoralCalendarCommandActor")
  pqrsdRulePackagesCreated           PqrsdRulePackage[]                    @relation("PqrsdRulePackageCreator")
  pqrsdRuleDecisionsMade             PqrsdRulePackageDecision[]            @relation("PqrsdRulePackageDecisionActor")
  pqrsdDossiersCreated               PqrsdDossier[]                        @relation("PqrsdDossierCreator")
  pqrsdDossiersAssigned              PqrsdDossier[]                        @relation("PqrsdDossierPrimaryAssignee")
