/// Reproducible deadline snapshot. Trace fields preserve every included and
/// excluded civil date; later package changes never rewrite these rows.
model PqrsdDeadlineVersion {
  id                   String                         @id @default(cuid())
  tenantId             String
  dossierId            String
  classificationId     String
  packageId            String
  ruleDefinitionId     String
  extensionProposalId  String?
  versionNumber        Int
  calculationStatus    PqrsdDeadlineCalculationStatus
  startLocalDate       DateTime                       @db.Date
  startExplanation     String                         @db.VarChar(1500)
  originalDueLocalDate DateTime?                      @db.Date
  currentDueLocalDate  DateTime?                      @db.Date
  dueAt                DateTime?
  includedDays         Json
  excludedDays         Json
  calculationTrace     Json
  changeReason         String                         @db.VarChar(1500)
  changeAuthority      String                         @db.VarChar(1000)
  createdById          String
  createdAt            DateTime                       @default(now())
  tenant               Tenant                         @relation(fields: [tenantId], references: [id])
  dossier              PqrsdDossier                   @relation(fields: [dossierId, tenantId], references: [id, tenantId])
  classification       PqrsdClassificationVersion     @relation(fields: [classificationId, tenantId], references: [id, tenantId])
  package              PqrsdRulePackage               @relation(fields: [packageId, tenantId], references: [id, tenantId])
  ruleDefinition       PqrsdRuleDefinition            @relation(fields: [ruleDefinitionId, tenantId], references: [id, tenantId])
  extensionProposal    PqrsdExtensionProposal?        @relation(fields: [extensionProposalId, tenantId], references: [id, tenantId])
  createdBy            User                           @relation("PqrsdDeadlineCreator", fields: [createdById, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@unique([tenantId, dossierId, versionNumber])
  @@unique([extensionProposalId, tenantId])
  @@index([tenantId, dossierId, currentDueLocalDate])
}

