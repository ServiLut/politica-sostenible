  backup                 User?                               @relation("ElectoralCalendarMilestoneBackup", fields: [backupUserId, tenantId], references: [id, tenantId], map: "ElectoralCalendarMilestone_backup_fkey")
  linkedTask             Task?                               @relation(fields: [linkedTaskId, tenantId], references: [id, tenantId], map: "ElectoralCalendarMilestone_task_fkey")
  linkedEvent            CampaignEvent?                      @relation(fields: [linkedEventId, tenantId], references: [id, tenantId], map: "ElectoralCalendarMilestone_event_fkey")
  results                ElectoralCalendarMilestoneResult[]

  @@unique([id, tenantId], map: "ElectoralCalendarMilestone_id_tenant_key")
  @@unique([tenantId, releaseId, stableKey], map: "ElectoralCalendarMilestone_release_key")
  @@index([tenantId, releaseId, localDate], map: "ElectoralCalendarMilestone_release_date_idx")
  @@index([tenantId, responsibleUserId, localDate], map: "ElectoralCalendarMilestone_owner_date_idx")
  @@index([tenantId, category, stageGateRequired], map: "ElectoralCalendarMilestone_gate_idx")
}

