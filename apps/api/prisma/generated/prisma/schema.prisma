model ElectoralCatalogEntry {
  id                 String                    @id @default(cuid())
  tenantId           String
  releaseId          String
  namespace          ElectoralCodeNamespace
  type               ElectoralCatalogEntryType
  canonicalCode      String                    @db.VarChar(32)
  departmentCode     String                    @db.VarChar(2)
  municipalityCode   String?                   @db.VarChar(3)
  zoneCode           String?                   @db.VarChar(2)
  pollingPlaceCode   String?                   @db.VarChar(2)
  sourceLocationCode String?                   @db.VarChar(32)
  votingDate         DateTime?                 @db.Date
  timeZone           String?                   @db.VarChar(100)
  parentId           String?
  name               String                    @db.VarChar(240)
  nameIsDerived      Boolean                   @default(false)
  address            String?                   @db.VarChar(500)
  commune            String?                   @db.VarChar(240)
