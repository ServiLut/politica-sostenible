  preferredChannel     String       @db.VarChar(80)
  maskedFullName       String       @db.VarChar(240)
  maskedDocumentNumber String?      @db.VarChar(80)
  maskedEmail          String?      @db.VarChar(320)
  maskedPhone          String?      @db.VarChar(60)
  createdAt            DateTime     @default(now())
