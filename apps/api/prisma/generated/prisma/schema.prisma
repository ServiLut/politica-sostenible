  pqrsdAuthorizationsMade            PqrsdResponseAuthorization[]          @relation("PqrsdResponseAuthorizer")
  pqrsdDeliveriesRecorded            PqrsdDeliveryAttempt[]                @relation("PqrsdDeliveryActor")
  pqrsdClosuresRecorded              PqrsdClosure[]                        @relation("PqrsdClosureActor")
  pqrsdReopeningsRecorded            PqrsdReopening[]                      @relation("PqrsdReopeningActor")
  pqrsdStatusEventsRecorded          PqrsdStatusEvent[]                    @relation("PqrsdStatusEventActor")
  pqrsdCommands                      PqrsdCommand[]                        @relation("PqrsdCommandActor")
  transitionHandoverReportsGenerated TransitionHandoverReport[]            @relation("TransitionHandoverReportGenerator")

  @@unique([id, tenantId])
  @@unique([documentId, tenantId])
  @@index([tenantId, role])
  @@index([tenantId, isActive, role])
  @@index([tenantId, divisionId])
}

/// Invitacion de acceso de un solo uso. El token nunca se persiste en claro:
/// solo se conserva su SHA-256 para comprobar la aceptacion.
model TeamInvitation {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  role        Role
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  invitedBy   User      @relation("InvitationInviter", fields: [invitedById, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@index([tenantId, email, acceptedAt, expiresAt])
  @@index([tenantId, invitedById, createdAt])
}

model PoliticalDivision {
  id                     String                        @id @default(cuid())
  code                   String
  name                   String
  type                   DivisionType
  parentId               String?
  tenantId               String
  expectedTables         Int?
  goal                   Int? /// Meta de personas a registrar en este territorio
  sourceNamespace        ElectoralCodeNamespace?
  sourceReleaseId        String?
  sourceLocationCode     String?                       @db.VarChar(32)
  votingDate             DateTime?                     @db.Date
  timeZone               String?                       @db.VarChar(100)
  address                String?                       @db.VarChar(500)
  commune                String?                       @db.VarChar(240)
  latitude               Decimal?                      @db.Decimal(9, 6)
  longitude              Decimal?                      @db.Decimal(10, 6)
  isActive               Boolean                       @default(true)
  retiredAt              DateTime?
  tenant                 Tenant                        @relation("TenantDivisions", fields: [tenantId], references: [id])
  parent                 PoliticalDivision?            @relation("Hierarchy", fields: [parentId, tenantId], references: [id, tenantId])
  children               PoliticalDivision[]           @relation("Hierarchy")
  sourceRelease          ElectoralCatalogRelease?      @relation("PoliticalDivisionSourceRelease", fields: [sourceReleaseId, tenantId], references: [id, tenantId], map: "PoliticalDivision_sourceRelease_fkey")
  users                  User[]
  voters                 Voter[]                       @relation("VoterPuesto")
  witnesses              WitnessReport[]
  issueCases             IssueCase[]
  offlineE14GrantPlaces  OfflineE14CaptureGrantPlace[]
  inventoryDestinations  InventoryTransfer[]           @relation("InventoryTransferDestinationDivision")
  witnessAssignments     WitnessAssignment[]
  witnessCoverageWindows WitnessCoverageWindow[]
  scrutinyCommissions    ScrutinyCommission[]          @relation("ScrutinyCommissionScope")
