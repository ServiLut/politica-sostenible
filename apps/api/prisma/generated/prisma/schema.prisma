  validatedBy               User?                       @relation("ElectoralCatalogValidatedBy", fields: [validatedById, tenantId], references: [id, tenantId], map: "ElectoralCatalogRelease_validatedBy_fkey")
  activatedBy               User?                       @relation("ElectoralCatalogActivatedBy", fields: [activatedById, tenantId], references: [id, tenantId], map: "ElectoralCatalogRelease_activatedBy_fkey")
  approvedBy                User?                       @relation("ElectoralCatalogApprovedBy", fields: [approvedById, tenantId], references: [id, tenantId], map: "ElectoralCatalogRelease_approvedBy_fkey")
