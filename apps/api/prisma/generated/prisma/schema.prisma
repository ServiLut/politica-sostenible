// ─── Operation Profile ──────────────────────────────────────────────────────

model OperationProfile {
  id                    String                       @id @default(cuid())
  tenantId              String                       @unique
  operationType         PoliticalOperationType
  stage                 PoliticalOperationStage
  electionType          ElectoralContestType
  circumscriptionType   ElectoralCircumscriptionType
  circumscriptionName   String                       @db.VarChar(160)
  circumscriptionCode   String?                      @db.VarChar(64)
  listType              CandidateListType?
  electionDate          DateTime
  expectedTeamSize      Int
  candidateCount        Int                          @default(1)
  dataControllerName    String                       @db.VarChar(200)
  responsibleDataUserId String
  retentionPeriodDays   Int
  revocationProcedure   String                       @db.VarChar(2000)
  createdById           String
  updatedById           String
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  tenant                Tenant                       @relation(fields: [tenantId], references: [id])
  responsibleDataUser   User                         @relation("OperationProfileResponsible", fields: [responsibleDataUserId, tenantId], references: [id, tenantId])
  createdBy             User                         @relation("OperationProfileCreatedBy", fields: [createdById, tenantId], references: [id, tenantId])
  updatedBy             User                         @relation("OperationProfileUpdatedBy", fields: [updatedById, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@index([tenantId, operationType, stage])
  @@index([tenantId, electionDate])
  @@index([tenantId, responsibleDataUserId])
}

enum PoliticalOperationType {
  PRE_CANDIDACY
  SINGLE_CANDIDACY
  CORPORATION_CANDIDACY
  PARTY_MOVEMENT
  SIGNATURE_COMMITTEE
  TERRITORIAL_TEAM
}

enum PoliticalOperationStage {
  EXPLORATION
  PRE_CAMPAIGN
  SIGNATURE_COLLECTION
  CAMPAIGN
  ELECTION_PREPARATION
  SIMULATION
  ELECTION_DAY
  POST_ELECTION
  CLOSED
}

enum ElectoralContestType {
  PRESIDENCY
  GOVERNORSHIP
  MAYORALTY
  SENATE
  HOUSE_OF_REPRESENTATIVES
  DEPARTMENTAL_ASSEMBLY
  MUNICIPAL_COUNCIL
  LOCAL_ADMINISTRATIVE_BOARD
  INTERNAL_ELECTION
  OTHER
}

enum ElectoralCircumscriptionType {
  NATIONAL
  DEPARTMENTAL
  MUNICIPAL
  LOCAL
  SPECIAL
  INTERNAL
}

enum CandidateListType {
  CLOSED
  OPEN_PREFERENTIAL
}

model PoliticalProposal {
  id              String           @id @default(cuid())
  tenantId        String
  referenceCode   String           @db.VarChar(20)
  title           String           @db.VarChar(200)
  description     String           @db.VarChar(2000)
  category        ProposalCategory
  targetGroup     String?          @db.VarChar(200)
  status          ProposalStatus   @default(DRAFT)
  progressPercent Int              @default(0)
  isPublic        Boolean          @default(false)
  territory       String?          @db.VarChar(200)
  estimatedCost   Decimal?         @db.Decimal(15, 2)
  sourceUrl       String?          @db.VarChar(500)
  ownerId         String
  createdById     String
  updatedById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  owner           User             @relation("ProposalOwner", fields: [ownerId, tenantId], references: [id, tenantId])
  createdBy       User             @relation("ProposalCreatedBy", fields: [createdById, tenantId], references: [id, tenantId])
  updatedBy       User             @relation("ProposalUpdatedBy", fields: [updatedById, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@unique([referenceCode, tenantId])
  @@index([tenantId, category, status])
  @@index([tenantId, isPublic])
}

enum ProposalCategory {
  EDUCATION
  HEALTH
  INFRASTRUCTURE
  SECURITY
  ECONOMY
  ENVIRONMENT
  CULTURE
  SOCIAL
  GOVERNANCE
  OTHER
}

enum ProposalStatus {
  DRAFT
  PROPOSED
  IN_PROGRESS
  COMPLETED
  WITHDRAWN
}

model SubscriptionPlan {
  id              String               @id @default(cuid())
  name            String               @db.VarChar(100)
  code            PlanCode             @unique
  description     String               @db.VarChar(500)
  maxUsers        Int
  maxVoters       Int
  maxStorageMb    Int
  includesExport  Boolean              @default(false)
  includesImport  Boolean              @default(false)
  includesMfa     Boolean              @default(false)
  includesApi     Boolean              @default(false)
  monthlyPriceCop Decimal              @db.Decimal(12, 2)
  yearlyPriceCop  Decimal              @db.Decimal(12, 2)
  isActive        Boolean              @default(true)
  sortOrder       Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  subscriptions   TenantSubscription[]
}

model TenantSubscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIAL)
  billingCycle       BillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])

  @@index([tenantId, status])
  @@index([planId])
  @@index([currentPeriodEnd, status])
}

enum PlanCode {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}
