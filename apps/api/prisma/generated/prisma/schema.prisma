  authority  String              @db.VarChar(1000)
  actorId    String
  occurredAt DateTime            @default(now())
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  dossier    PqrsdDossier        @relation(fields: [dossierId, tenantId], references: [id, tenantId])
