model ElectoralCalendarCommand {
  id                 String                            @id @db.Uuid
  tenantId           String
  operationProfileId String
  clientRequestId    String                            @db.Uuid
  payloadSha256      String                            @db.Char(64)
  type               ElectoralCalendarCommandType
  actorUserId        String
  resourceType       String                            @db.VarChar(80)
  resourceId         String                            @db.Uuid
  resultSnapshot     Json
  createdAt          DateTime                          @default(now())
  tenant             Tenant                            @relation(fields: [tenantId], references: [id], map: "ElectoralCalendarCommand_tenant_fkey")
  operationProfile   OperationProfile                  @relation(fields: [operationProfileId, tenantId], references: [id, tenantId], map: "ElectoralCalendarCommand_profile_fkey")
