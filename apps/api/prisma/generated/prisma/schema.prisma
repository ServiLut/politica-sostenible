  @@unique([id, tenantId])
  @@unique([tenantId, packageId])
  @@index([tenantId, actorId, decidedAt])
}

/// Formal PQRSD dossier. It intentionally has no relation to campaign Voter,
/// Interaction or the lightweight CAS-GP IssueCase aggregate.
model PqrsdDossier {
  id                       String                        @id @default(cuid())
  tenantId                 String
  reference                String                        @db.VarChar(80)
  rulePackageId            String
  receivedAt               DateTime
  receivedTimeZone         String                        @db.VarChar(100)
  receivedChannel          String                        @db.VarChar(120)
  externalReceiptNumber    String?                       @db.VarChar(160)
  subject                  String                        @db.VarChar(500)
  description              String                        @db.Text
  acknowledgementRequired  Boolean                       @default(true)
  status                   PqrsdDossierStatus            @default(RECEIVED)
  riskLevel                PqrsdRiskLevel                @default(NORMAL)
  currentPrimaryAssigneeId String?
  currentBackupAssigneeId  String?
  version                  Int                           @default(1)
  createdById              String
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  tenant                   Tenant                        @relation(fields: [tenantId], references: [id])
  rulePackage              PqrsdRulePackage              @relation(fields: [rulePackageId, tenantId], references: [id, tenantId])
  createdBy                User                          @relation("PqrsdDossierCreator", fields: [createdById, tenantId], references: [id, tenantId])
  currentPrimaryAssignee   User?                         @relation("PqrsdDossierPrimaryAssignee", fields: [currentPrimaryAssigneeId, tenantId], references: [id, tenantId])
  currentBackupAssignee    User?                         @relation("PqrsdDossierBackupAssignee", fields: [currentBackupAssigneeId, tenantId], references: [id, tenantId])
  petitioner               PqrsdPetitionerSnapshot?
  documents                PqrsdDocument[]
  acknowledgements         PqrsdReceiptAcknowledgement[]
  detailAccesses           PqrsdDetailAccess[]
  classifications          PqrsdClassificationVersion[]
  deadlines                PqrsdDeadlineVersion[]
  assignments              PqrsdAssignmentEvent[]
  transfers                PqrsdTransfer[]
  transferAttempts         PqrsdTransferAttempt[]
  extensions               PqrsdExtensionProposal[]
  responses                PqrsdResponseVersion[]
  deliveryAttempts         PqrsdDeliveryAttempt[]
  closures                 PqrsdClosure[]
  reopenings               PqrsdReopening[]
  statusEvents             PqrsdStatusEvent[]

  @@unique([id, tenantId])
  @@unique([tenantId, reference])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, currentPrimaryAssigneeId, status])
  @@index([tenantId, currentBackupAssigneeId, status])
  @@index([tenantId, rulePackageId])
  @@index([createdById])
}

