  sourceReference String                     @db.VarChar(1000)
  createdAt       DateTime                   @default(now())
  tenant          Tenant                     @relation(fields: [tenantId], references: [id])
  package         PqrsdRulePackage           @relation(fields: [packageId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([tenantId, packageId, localDate])
  @@index([tenantId, packageId, localDate])
}

model PqrsdRulePackageDecision {
