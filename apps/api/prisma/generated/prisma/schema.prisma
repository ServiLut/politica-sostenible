/// Snapshot tenant-scoped, versionado e inmutable de una fuente territorial.
/// El contenido nunca incluye votantes, testigos ni otra informacion personal.
model ElectoralCatalogRelease {
  id                        String                      @id @default(cuid())
  tenantId                  String
  catalogKey                String                      @db.VarChar(160)
  type                      ElectoralCatalogType
  status                    ElectoralCatalogStatus      @default(STAGED)
  sourceUrl                 String                      @db.VarChar(2048)
  sourceOrganization        String                      @db.VarChar(200)
  sourceDataset             String                      @db.VarChar(300)
  sourceCutoffAt            DateTime?
  electionDate              DateTime?                   @db.Date
  contentSha256             String                      @db.Char(64)
  parserVersion             String                      @db.VarChar(80)
  authorizationReference    String?                     @db.VarChar(500)
