  @@unique([id, tenantId])
  @@unique([tenantId, clientRequestId], map: "FinanceCloseoutCommand_tenant_client_key")
  @@index([tenantId, actorUserId, createdAt], map: "FinanceCloseoutCommand_actor_idx")
}

model WitnessReport {
  id                     String                    @id @default(cuid())
  tenantId               String
  witnessId              String
  puestoId               String
  mesa                   Int
  e14ImageUrl            String                    @unique
  captureContext         WitnessCaptureContext
  credentialType         WitnessCredentialType?
  credentialReference    String?                   @db.VarChar(120)
  checkedInAt            DateTime?
  e14FormType            E14FormType?
  candidateVotes         Int
  blankVotes             Int?
  nullVotes              Int?
  unmarkedVotes          Int?
  totalTableVotes        Int
  hasWrittenClaim        Boolean?
  reclamationGround      WitnessReclamationGround?
  reclamationDescription String?                   @db.VarChar(2000)
  observations           String?
  isSynced               Boolean                   @default(false)
  status                 WitnessReportStatus       @default(PENDING)
  reviewerId             String?
  reviewReason           String?                   @db.VarChar(1000)
  reviewedAt             DateTime?
  supersededById         String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  tenant                 Tenant                    @relation(fields: [tenantId], references: [id])
  puesto                 PoliticalDivision         @relation(fields: [puestoId, tenantId], references: [id, tenantId])
  witness                User                      @relation("WitnessReportReporter", fields: [witnessId, tenantId], references: [id, tenantId])
  reviewer               User?                     @relation("WitnessReportReviewer", fields: [reviewerId, tenantId], references: [id, tenantId])
  supersededBy           WitnessReport?            @relation("WitnessReportSupersession", fields: [supersededById, tenantId, captureContext], references: [id, tenantId, captureContext])
  supersededReports      WitnessReport[]           @relation("WitnessReportSupersession")

  @@unique([id, tenantId])
  @@unique([id, tenantId, captureContext])
  @@index([tenantId, witnessId, createdAt])
  @@index([tenantId, isSynced])
  @@index([tenantId, captureContext, status, createdAt], map: "WitnessReport_tenant_context_status_created_idx")
  @@index([tenantId, captureContext, puestoId, mesa, status, createdAt], map: "WitnessReport_tenant_context_table_status_created_idx")
  @@index([tenantId, status, createdAt])
  @@index([tenantId, puestoId, mesa, status, createdAt])
  @@index([tenantId, credentialType, credentialReference])
  @@index([tenantId, hasWrittenClaim, createdAt])
  @@index([tenantId, reviewerId, reviewedAt])
  @@index([tenantId, supersededById])
}

/// Plan durable de cobertura por puesto, rango exacto de mesas y turno.
/// Las asignaciones canceladas se conservan para trazabilidad y no se eliminan.
model WitnessAssignment {
  id                          String                  @id @default(cuid())
  tenantId                    String
  operationProfileId          String
  coverageWindowId            String
  clientRequestId             String                  @db.Uuid
  payloadSha256               String                  @db.Char(64)
  captureContext              WitnessCaptureContext
  puestoId                    String
  tableStart                  Int
  tableEnd                    Int
  shiftStartsAt               DateTime
  shiftEndsAt                 DateTime
  assignmentType              WitnessAssignmentType
  status                      WitnessAssignmentStatus @default(PLANNED)
  witnessId                   String
  createdById                 String
  confirmedById               String?
  confirmedAt                 DateTime?
  confirmationClientRequestId String?                 @db.Uuid
  confirmationPayloadSha256   String?                 @db.Char(64)
  cancelledById               String?
  cancelledAt                 DateTime?
  cancellationClientRequestId String?                 @db.Uuid
  cancellationPayloadSha256   String?                 @db.Char(64)
  cancellationReason          String?                 @db.VarChar(1000)
  supersedesAssignmentId      String?
  version                     Int                     @default(1)
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  tenant                      Tenant                  @relation(fields: [tenantId], references: [id], map: "WitnessAssignment_tenant_fkey")
  operationProfile            OperationProfile        @relation(fields: [operationProfileId, tenantId], references: [id, tenantId], map: "WitnessAssignment_profile_fkey")
  coverageWindow              WitnessCoverageWindow   @relation(fields: [coverageWindowId, tenantId], references: [id, tenantId], map: "WitnessAssignment_window_fkey")
  puesto                      PoliticalDivision       @relation(fields: [puestoId, tenantId], references: [id, tenantId], map: "WitnessAssignment_puesto_fkey")
  witness                     User                    @relation("WitnessAssignmentWitness", fields: [witnessId, tenantId], references: [id, tenantId], map: "WitnessAssignment_witness_fkey")
  createdBy                   User                    @relation("WitnessAssignmentCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], map: "WitnessAssignment_creator_fkey")
  confirmedBy                 User?                   @relation("WitnessAssignmentConfirmedBy", fields: [confirmedById, tenantId], references: [id, tenantId], map: "WitnessAssignment_confirmer_fkey")
  cancelledBy                 User?                   @relation("WitnessAssignmentCancelledBy", fields: [cancelledById, tenantId], references: [id, tenantId], map: "WitnessAssignment_canceller_fkey")
  supersedes                  WitnessAssignment?      @relation("WitnessAssignmentReassignment", fields: [supersedesAssignmentId, tenantId], references: [id, tenantId], map: "WitnessAssignment_supersedes_fkey")
  replacement                 WitnessAssignment?      @relation("WitnessAssignmentReassignment")

  @@unique([id, tenantId])
  @@unique([tenantId, clientRequestId], map: "WitnessAssignment_tenant_client_key")
  @@unique([tenantId, confirmationClientRequestId], map: "WitnessAssignment_tenant_confirm_client_key")
  @@unique([tenantId, cancellationClientRequestId], map: "WitnessAssignment_tenant_cancel_client_key")
  @@unique([supersedesAssignmentId, tenantId], map: "WitnessAssignment_supersedes_tenant_key")
  @@index([tenantId, operationProfileId, captureContext, status], map: "WitnessAssignment_tenant_profile_context_status_idx")
  @@index([tenantId, coverageWindowId, status], map: "WitnessAssignment_tenant_window_status_idx")
  @@index([tenantId, puestoId, tableStart, tableEnd], map: "WitnessAssignment_tenant_place_tables_idx")
  @@index([tenantId, witnessId, shiftStartsAt, shiftEndsAt], map: "WitnessAssignment_tenant_witness_shift_idx")
  @@index([tenantId, status, shiftStartsAt, shiftEndsAt], map: "WitnessAssignment_tenant_status_shift_idx")
  @@index([createdById])
}

/// Ventana de cobertura declarada por puesto y jornada local. No presume un
/// horario electoral universal: conserva instantes, zona IANA y offset usado.
model WitnessCoverageWindow {
  id                 String                         @id @default(cuid())
  tenantId           String
  operationProfileId String
  clientRequestId    String                         @db.Uuid
  payloadSha256      String                         @db.Char(64)
  captureContext     WitnessCaptureContext
  puestoId           String
  localDate          DateTime                       @db.Date
  startsAt           DateTime
  endsAt             DateTime
  timeZone           String                         @db.VarChar(64)
  utcOffsetMinutes   Int
  version            Int                            @default(1)
  createdById        String
  updatedById        String
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  tenant             Tenant                         @relation(fields: [tenantId], references: [id], map: "WitnessCoverageWindow_tenant_fkey")
  operationProfile   OperationProfile               @relation(fields: [operationProfileId, tenantId], references: [id, tenantId], map: "WitnessCoverageWindow_profile_fkey")
  puesto             PoliticalDivision              @relation(fields: [puestoId, tenantId], references: [id, tenantId], map: "WitnessCoverageWindow_puesto_fkey")
  createdBy          User                           @relation("WitnessCoverageWindowCreatedBy", fields: [createdById, tenantId], references: [id, tenantId], map: "WitnessCoverageWindow_creator_fkey")
  updatedBy          User                           @relation("WitnessCoverageWindowUpdatedBy", fields: [updatedById, tenantId], references: [id, tenantId], map: "WitnessCoverageWindow_updater_fkey")
  assignments        WitnessAssignment[]
  commands           WitnessCoverageWindowCommand[]

  @@unique([id, tenantId])
  @@unique([tenantId, clientRequestId], map: "WitnessCoverageWindow_tenant_client_key")
  @@unique([tenantId, operationProfileId, captureContext, puestoId, localDate], map: "WitnessCoverageWindow_natural_key")
  @@index([tenantId, operationProfileId, captureContext, localDate], map: "WitnessCoverageWindow_tenant_profile_context_date_idx")
  @@index([tenantId, puestoId, startsAt, endsAt], map: "WitnessCoverageWindow_tenant_place_time_idx")
}

/// Recibo append-only de creación o reprogramación idempotente de una ventana.
model WitnessCoverageWindowCommand {
  id               String                           @id @default(cuid())
  tenantId         String
  coverageWindowId String
  clientRequestId  String                           @db.Uuid
  payloadSha256    String                           @db.Char(64)
  type             WitnessCoverageWindowCommandType
  actorUserId      String
  createdAt        DateTime                         @default(now())
  tenant           Tenant                           @relation(fields: [tenantId], references: [id], map: "WitnessCoverageWindowCommand_tenant_fkey")
  coverageWindow   WitnessCoverageWindow            @relation(fields: [coverageWindowId, tenantId], references: [id, tenantId], map: "WitnessCoverageWindowCommand_window_fkey")
  actor            User                             @relation("WitnessCoverageWindowCommandActor", fields: [actorUserId, tenantId], references: [id, tenantId], map: "WitnessCoverageWindowCommand_actor_fkey")

  @@unique([id, tenantId])
  @@unique([tenantId, clientRequestId], map: "WitnessCoverageWindowCommand_tenant_client_key")
  @@index([tenantId, coverageWindowId, createdAt], map: "WitnessCoverageWindowCommand_tenant_window_created_idx")
}

model CampaignEvent {
  id                 String                       @id @default(cuid())
  name               String
  description        String?
  startsAt           DateTime                     @map("date")
  endsAt             DateTime
  location           String?
  status             CampaignEventStatus          @default(DRAFT)
  capacity           Int?
  responsibleId      String?
  mode               PoliticalOperationMode
  points             Int                          @default(0)
  tenantId           String
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  tenant             Tenant                       @relation(fields: [tenantId], references: [id])
  responsible        User?                        @relation("EventResponsible", fields: [responsibleId, tenantId], references: [id, tenantId])
  attendees          PointLog[]
  calendarMilestones ElectoralCalendarMilestone[]

  @@unique([id, tenantId])
  @@index([tenantId, mode, startsAt])
  @@index([tenantId, mode, status, startsAt])
  @@index([tenantId, responsibleId, startsAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Legacy operational tables retained in the schema so Prisma never proposes
/// a destructive drop. No current UI advertises these flows.
model PointLog {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  amount    Int
  reason    String
  eventId   String?
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  user      User           @relation(fields: [userId, tenantId], references: [id, tenantId])
  event     CampaignEvent? @relation(fields: [eventId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, eventId])
}

model InventoryItem {
  id            String                  @id @default(cuid())
  name          String
  sku           String?
  /// Compatibilidad histórica: el saldo operativo vive en InventoryStockBalance.
  quantity      Int                     @default(0)
  /// Texto de ubicación legado; no se usa para despachos nuevos.
  warehouse     String?
  tenantId      String
  description   String?                 @db.VarChar(1000)
  unit          String?                 @db.VarChar(40)
  trackingMode  InventoryTrackingMode?
  minimumStock  Int?
  recordOrigin  InventoryRecordOrigin
  isActive      Boolean                 @default(true)
  createdById   String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  createdBy     User?                   @relation("InventoryItemCreatedBy", fields: [createdById, tenantId], references: [id, tenantId])
  movements     InventoryMovement[]
  stockBalances InventoryStockBalance[]
  transferLines InventoryTransferLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@index([tenantId, isActive, trackingMode])
  @@index([tenantId, createdById])
}

model InventoryMovement {
  id                String                 @id @default(cuid())
  tenantId          String
  itemId            String
  userId            String
  quantity          Int
  type              MovementType
  reason            String?
  recordOrigin      InventoryRecordOrigin
  commandId         String?
  warehouseId       String?
  stockBalanceId    String?
  transferId        String?
  transferLineId    String?
  delta             Int?
  balanceBefore     Int?
  balanceAfter      Int?
  occurredAt        DateTime?
  custodyFromUserId String?
  custodyToUserId   String?
  createdAt         DateTime               @default(now())
  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  item              InventoryItem          @relation(fields: [itemId, tenantId], references: [id, tenantId])
  user              User                   @relation("InventoryMovementActor", fields: [userId, tenantId], references: [id, tenantId])
  command           InventoryCommand?      @relation(fields: [commandId, tenantId], references: [id, tenantId])
  warehouse         InventoryWarehouse?    @relation(fields: [warehouseId, tenantId], references: [id, tenantId])
  stockBalance      InventoryStockBalance? @relation(fields: [stockBalanceId, tenantId], references: [id, tenantId])
  transfer          InventoryTransfer?     @relation(fields: [transferId, tenantId], references: [id, tenantId])
  transferLine      InventoryTransferLine? @relation(fields: [transferLineId, tenantId], references: [id, tenantId])
  custodyFromUser   User?                  @relation("InventoryMovementCustodyFrom", fields: [custodyFromUserId, tenantId], references: [id, tenantId])
  custodyToUser     User?                  @relation("InventoryMovementCustodyTo", fields: [custodyToUserId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@index([tenantId, itemId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, commandId])
  @@index([tenantId, warehouseId, occurredAt])
  @@index([tenantId, transferId, occurredAt])
}

model InventoryWarehouse {
  id                   String                  @id @default(cuid())
  tenantId             String
  code                 String                  @db.VarChar(32)
  name                 String                  @db.VarChar(160)
  address              String?                 @db.VarChar(500)
  responsibleUserId    String?
  isActive             Boolean                 @default(true)
  recordOrigin         InventoryRecordOrigin
  createdById          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  tenant               Tenant                  @relation(fields: [tenantId], references: [id])
  responsibleUser      User?                   @relation("InventoryWarehouseResponsible", fields: [responsibleUserId, tenantId], references: [id, tenantId])
  createdBy            User?                   @relation("InventoryWarehouseCreatedBy", fields: [createdById, tenantId], references: [id, tenantId])
  stockBalances        InventoryStockBalance[]
  movements            InventoryMovement[]
  outboundTransfers    InventoryTransfer[]     @relation("InventoryTransferSourceWarehouse")
  destinationTransfers InventoryTransfer[]     @relation("InventoryTransferDestinationWarehouse")

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, isActive, name])
  @@index([tenantId, responsibleUserId])
}

model InventoryStockBalance {
  id                String                  @id @default(cuid())
  tenantId          String
  itemId            String
  warehouseId       String
  trackingKey       String                  @db.VarChar(180)
  lotNumber         String?                 @db.VarChar(120)
  serialNumber      String?                 @db.VarChar(160)
  expiresAt         DateTime?
  condition         InventoryStockCondition
  quantity          Int
  responsibleUserId String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  tenant            Tenant                  @relation(fields: [tenantId], references: [id])
  item              InventoryItem           @relation(fields: [itemId, tenantId], references: [id, tenantId])
  warehouse         InventoryWarehouse      @relation(fields: [warehouseId, tenantId], references: [id, tenantId])
  responsibleUser   User?                   @relation("InventoryStockResponsible", fields: [responsibleUserId, tenantId], references: [id, tenantId])
  movements         InventoryMovement[]
  sourceLines       InventoryTransferLine[] @relation("InventoryTransferLineSourceStock")

  @@unique([id, tenantId])
  @@unique([tenantId, itemId, warehouseId, trackingKey], map: "InventoryStockBalance_tenant_item_warehouse_tracking_key")
  @@index([tenantId, warehouseId, condition, itemId], map: "InventoryStockBalance_tenant_warehouse_condition_item_idx")
  @@index([tenantId, itemId, serialNumber], map: "InventoryStockBalance_tenant_item_serial_idx")
  @@index([tenantId, expiresAt], map: "InventoryStockBalance_tenant_expires_idx")
}

model InventoryCommand {
  id              String                  @id @default(cuid())
  tenantId        String
  clientRequestId String                  @db.Uuid
  payloadSha256   String                  @db.Char(64)
  type            InventoryCommandType
  actorUserId     String
  resourceType    String                  @db.VarChar(80)
  resourceId      String?
  resultSummary   Json
  createdAt       DateTime                @default(now())
  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  actor           User                    @relation("InventoryCommandActor", fields: [actorUserId, tenantId], references: [id, tenantId])
  transfer        InventoryTransfer?
  custodyEvents   InventoryCustodyEvent[]
  incidents       InventoryIncident[]
  movements       InventoryMovement[]

  @@unique([id, tenantId])
  @@unique([tenantId, clientRequestId])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, actorUserId, createdAt])
}

model InventoryTransfer {
  id                     String                  @id @default(cuid())
  tenantId               String
  commandId              String
  code                   String                  @db.VarChar(64)
  sourceWarehouseId      String
  destinationWarehouseId String?
  destinationDivisionId  String?
  destinationLabel       String                  @db.VarChar(300)
  destinationTableNumber Int?
  custodianUserId        String
  status                 InventoryTransferStatus
  purpose                String                  @db.VarChar(1000)
  dispatchDeclaration    String                  @db.VarChar(1000)
  dispatchedById         String
  dispatchedAt           DateTime
  expectedReturnAt       DateTime?
  reconciledById         String?
  reconciledAt           DateTime?
  reconciliationNote     String?                 @db.VarChar(2000)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  command                InventoryCommand        @relation(fields: [commandId, tenantId], references: [id, tenantId])
  sourceWarehouse        InventoryWarehouse      @relation("InventoryTransferSourceWarehouse", fields: [sourceWarehouseId, tenantId], references: [id, tenantId])
  destinationWarehouse   InventoryWarehouse?     @relation("InventoryTransferDestinationWarehouse", fields: [destinationWarehouseId, tenantId], references: [id, tenantId])
  destinationDivision    PoliticalDivision?      @relation("InventoryTransferDestinationDivision", fields: [destinationDivisionId, tenantId], references: [id, tenantId])
  custodian              User                    @relation("InventoryTransferCustodian", fields: [custodianUserId, tenantId], references: [id, tenantId])
  dispatchedBy           User                    @relation("InventoryTransferDispatchedBy", fields: [dispatchedById, tenantId], references: [id, tenantId])
  reconciledBy           User?                   @relation("InventoryTransferReconciledBy", fields: [reconciledById, tenantId], references: [id, tenantId])
  lines                  InventoryTransferLine[]
  custodyEvents          InventoryCustodyEvent[]
  incidents              InventoryIncident[]
  movements              InventoryMovement[]

  @@unique([id, tenantId])
  @@unique([commandId, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, status, dispatchedAt])
  @@index([tenantId, custodianUserId, status])
  @@index([tenantId, destinationDivisionId, destinationTableNumber], map: "InventoryTransfer_tenant_destination_table_idx")
}

model InventoryTransferLine {
  id                      String                @id @default(cuid())
  tenantId                String
  transferId              String
  itemId                  String
  sourceStockBalanceId    String
  trackingKey             String                @db.VarChar(180)
  lotNumber               String?               @db.VarChar(120)
  serialNumber            String?               @db.VarChar(160)
  expiresAt               DateTime?
  dispatchedQuantity      Int
  receivedUsableQuantity  Int                   @default(0)
  receivedDamagedQuantity Int                   @default(0)
  transitMissingQuantity  Int                   @default(0)
  returnedQuantity        Int                   @default(0)
  consumedQuantity        Int                   @default(0)
  custodyMissingQuantity  Int                   @default(0)
  custodyDamagedQuantity  Int                   @default(0)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  tenant                  Tenant                @relation(fields: [tenantId], references: [id])
  transfer                InventoryTransfer     @relation(fields: [transferId, tenantId], references: [id, tenantId])
  item                    InventoryItem         @relation(fields: [itemId, tenantId], references: [id, tenantId])
  sourceStockBalance      InventoryStockBalance @relation("InventoryTransferLineSourceStock", fields: [sourceStockBalanceId, tenantId], references: [id, tenantId])
  movements               InventoryMovement[]
  incidents               InventoryIncident[]

  @@unique([id, tenantId])
  @@unique([tenantId, transferId, sourceStockBalanceId], map: "InventoryTransferLine_tenant_transfer_source_key")
  @@index([tenantId, itemId, transferId])
}

model InventoryCustodyEvent {
  id          String                    @id @default(cuid())
  tenantId    String
  transferId  String?
  commandId   String
  type        InventoryCustodyEventType
  actorUserId String
  fromUserId  String?
  toUserId    String?
  declaration String                    @db.VarChar(2000)
  occurredAt  DateTime
  createdAt   DateTime                  @default(now())
  tenant      Tenant                    @relation(fields: [tenantId], references: [id])
  transfer    InventoryTransfer?        @relation(fields: [transferId, tenantId], references: [id, tenantId])
  command     InventoryCommand          @relation(fields: [commandId, tenantId], references: [id, tenantId])
  actor       User                      @relation("InventoryCustodyEventActor", fields: [actorUserId, tenantId], references: [id, tenantId])
  fromUser    User?                     @relation("InventoryCustodyEventFrom", fields: [fromUserId, tenantId], references: [id, tenantId])
  toUser      User?                     @relation("InventoryCustodyEventTo", fields: [toUserId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@unique([tenantId, commandId])
  @@index([tenantId, transferId, occurredAt], map: "InventoryCustodyEvent_tenant_transfer_occurred_idx")
  @@index([tenantId, actorUserId, occurredAt], map: "InventoryCustodyEvent_tenant_actor_occurred_idx")
}

model InventoryIncident {
  id                String                 @id @default(cuid())
  tenantId          String
  transferId        String
  transferLineId    String?
  commandId         String
  type              InventoryIncidentType
  quantity          Int?
  description       String                 @db.VarChar(2000)
  evidenceReference String?                @db.VarChar(2048)
  evidenceSha256    String?                @db.Char(64)
  reportedById      String
  occurredAt        DateTime
  createdAt         DateTime               @default(now())
  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  transfer          InventoryTransfer      @relation(fields: [transferId, tenantId], references: [id, tenantId])
  transferLine      InventoryTransferLine? @relation(fields: [transferLineId, tenantId], references: [id, tenantId])
  command           InventoryCommand       @relation(fields: [commandId, tenantId], references: [id, tenantId])
  reportedBy        User                   @relation("InventoryIncidentReportedBy", fields: [reportedById, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@index([tenantId, transferId, occurredAt], map: "InventoryIncident_tenant_transfer_occurred_idx")
  @@index([tenantId, type, occurredAt], map: "InventoryIncident_tenant_type_occurred_idx")
  @@index([tenantId, commandId])
}

/// Historial versionado de autorizaciones de tratamiento de datos. No debe
/// sobrescribirse al revocar: se agrega un nuevo evento y se conserva la prueba.
model ConsentRecord {
  id                String                   @id @default(cuid())
  tenantId          String
  mode              PoliticalOperationMode
  subjectType       ConsentSubjectType
  subjectRef        String
  voterId           String?
  purpose           ConsentPurpose
  legalBasis        ConsentLegalBasis
  status            ConsentStatus            @default(GRANTED)
  collectionChannel ConsentCollectionChannel
  noticeVersion     String
  proofPath         String?
  sourceIpHash      String?
  /// Marca de tiempo declarada por el dispositivo para una captura offline.
  capturedAt        DateTime?
  /// Momento en que la API recibio y persistio una captura offline.
  receivedAt        DateTime?
  /// Hash de la IP observada al sincronizar; no representa la IP de captura.
  syncSourceIpHash  String?
  capturedById      String?
  grantedAt         DateTime
  expiresAt         DateTime?
  revokedAt         DateTime?
  revocationReason  String?                  @db.VarChar(500)
  createdAt         DateTime                 @default(now())
  tenant            Tenant                   @relation(fields: [tenantId], references: [id])
  voter             Voter?                   @relation(fields: [voterId, tenantId], references: [id, tenantId])
  capturedBy        User?                    @relation("ConsentCapturedBy", fields: [capturedById, tenantId], references: [id, tenantId])
  interactions      Interaction[]

  @@unique([id, tenantId])
  @@index([tenantId, mode, subjectRef, purpose, status])
  @@index([tenantId, voterId])
  @@index([tenantId, expiresAt])
  @@index([capturedById])
}

/// Versiones del aviso de privacidad configuradas por cada organización.
/// Una versión retirada se conserva para poder reconstruir qué información
/// recibió la persona al autorizar el tratamiento.
model ConsentNotice {
  id               String                 @id @default(cuid())
  tenantId         String
  mode             PoliticalOperationMode
  purpose          ConsentPurpose
  version          String                 @db.VarChar(32)
  title            String                 @db.VarChar(160)
  content          String                 @db.Text
  controllerName   String                 @db.VarChar(200)
  contactEmail     String                 @db.VarChar(254)
  privacyPolicyUrl String?                @db.VarChar(2048)
  isActive         Boolean                @default(true)
  createdById      String
  activatedAt      DateTime               @default(now())
  retiredAt        DateTime?
  createdAt        DateTime               @default(now())
  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  createdBy        User                   @relation("ConsentNoticeCreatedBy", fields: [createdById, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@unique([tenantId, mode, purpose, version])
  @@index([tenantId, mode, purpose, isActive])
  @@index([tenantId, createdById, createdAt])
}

/// Solicitud ciudadana, incidencia territorial o caso de campaña, con SLA y
/// responsable explícitos. `mode` impide mezclar gestión pública y proselitismo.
model IssueCase {
  id                     String                  @id @default(cuid())
  tenantId               String
  mode                   PoliticalOperationMode
  reference              String
  title                  String
  description            String
  category               String
  sourceChannel          CommunicationChannel
  status                 IssueCaseStatus         @default(OPEN)
  priority               WorkPriority            @default(MEDIUM)
  voterId                String?
  externalContactRef     String?
  divisionId             String?
  assigneeId             String?
  createdById            String?
  confidential           Boolean                 @default(false)
  /// Fecha civil declarada del incidente. Es nullable para conservar los
  /// casos anteriores y no intenta derivar una zona horaria juridica.
  occurredOn             DateTime?               @db.Date
  dueAt                  DateTime?
  firstResponseAt        DateTime?
  resolvedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  voter                  Voter?                  @relation(fields: [voterId, tenantId], references: [id, tenantId])
  division               PoliticalDivision?      @relation(fields: [divisionId, tenantId], references: [id, tenantId])
  assignee               User?                   @relation("CaseAssignee", fields: [assigneeId, tenantId], references: [id, tenantId])
  createdBy              User?                   @relation("CaseCreatedBy", fields: [createdById, tenantId], references: [id, tenantId])
  interactions           Interaction[]
  tasks                  Task[]
  commitments            Commitment[]
  communicationApprovals CommunicationApproval[]

  @@unique([id, tenantId])
  @@unique([tenantId, mode, reference])
  @@index([tenantId, mode, status, priority])
  @@index([tenantId, assigneeId, dueAt])
  @@index([tenantId, voterId])
  @@index([tenantId, divisionId])
  @@index([tenantId, mode, occurredOn])
  @@index([reference(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([category(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([externalContactRef(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([createdById])
}

model Interaction {
  id                 String                 @id @default(cuid())
  tenantId           String
  mode               PoliticalOperationMode
  issueCaseId        String?
  voterId            String?
  externalContactRef String?
  actorId            String?
  consentRecordId    String?
  channel            CommunicationChannel
  direction          InteractionDirection
  summary            String
  outcome            String?
  sentiment          InteractionSentiment?
  occurredAt         DateTime               @default(now())
  createdAt          DateTime               @default(now())
  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  issueCase          IssueCase?             @relation(fields: [issueCaseId, tenantId], references: [id, tenantId])
  voter              Voter?                 @relation(fields: [voterId, tenantId], references: [id, tenantId])
  actor              User?                  @relation("InteractionActor", fields: [actorId, tenantId], references: [id, tenantId])
  consentRecord      ConsentRecord?         @relation(fields: [consentRecordId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@index([tenantId, mode, occurredAt])
  @@index([tenantId, issueCaseId, occurredAt])
  @@index([tenantId, voterId, occurredAt])
  @@index([actorId])
}

model Task {
  id                 String                       @id @default(cuid())
  tenantId           String
  mode               PoliticalOperationMode
  issueCaseId        String?
  commitmentId       String?
  title              String
  description        String?
  status             TaskStatus                   @default(TODO)
  priority           WorkPriority                 @default(MEDIUM)
  assigneeId         String?
  createdById        String
  dueAt              DateTime?
  completedAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  tenant             Tenant                       @relation(fields: [tenantId], references: [id])
  issueCase          IssueCase?                   @relation(fields: [issueCaseId, tenantId], references: [id, tenantId])
  commitment         Commitment?                  @relation(fields: [commitmentId, tenantId], references: [id, tenantId])
  assignee           User?                        @relation("TaskAssignee", fields: [assigneeId, tenantId], references: [id, tenantId])
  createdBy          User                         @relation("TaskCreator", fields: [createdById, tenantId], references: [id, tenantId])
  calendarMilestones ElectoralCalendarMilestone[]

  @@unique([id, tenantId], map: "Task_id_tenant_key")
  @@index([tenantId, mode, status, dueAt])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, issueCaseId])
  @@index([tenantId, commitmentId])
  @@index([createdById])
}

/// Promesa de campaña o compromiso de gobierno con seguimiento verificable.
model Commitment {
  id           String                 @id @default(cuid())
  tenantId     String
  mode         PoliticalOperationMode
  reference    String
  title        String
  description  String
  status       CommitmentStatus       @default(PROPOSED)
  ownerId      String?
  issueCaseId  String?
  targetDate   DateTime?
  progress     Int                    @default(0)
  isPublic     Boolean                @default(false)
  evidencePath String?
  completedAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  owner        User?                  @relation("CommitmentOwner", fields: [ownerId, tenantId], references: [id, tenantId])
  issueCase    IssueCase?             @relation(fields: [issueCaseId, tenantId], references: [id, tenantId])
  tasks        Task[]

  @@unique([id, tenantId])
  @@unique([tenantId, reference])
  @@index([tenantId, mode, status, targetDate])
  @@index([tenantId, ownerId])
  @@index([issueCaseId])
}

/// Flujo de cuatro ojos para mensajes públicos: el hash identifica exactamente
/// la versión revisada y evita publicar una versión distinta a la aprobada.
model CommunicationApproval {
  id                    String                      @id @default(cuid())
  tenantId              String
  mode                  PoliticalOperationMode
  issueCaseId           String?
  channel               CommunicationChannel
  title                 String
  content               Json
  contentHash           String
  purpose               String
  containsSensitiveData Boolean                     @default(false)
  status                CommunicationApprovalStatus @default(PENDING)
  requestedById         String
  decidedById           String?
  decisionReason        String?
  scheduledAt           DateTime?
  decidedAt             DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  tenant                Tenant                      @relation(fields: [tenantId], references: [id])
  issueCase             IssueCase?                  @relation(fields: [issueCaseId, tenantId], references: [id, tenantId])
  requestedBy           User                        @relation("CommunicationRequestedBy", fields: [requestedById, tenantId], references: [id, tenantId])
  decidedBy             User?                       @relation("CommunicationDecidedBy", fields: [decidedById, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@index([tenantId, mode, status, createdAt])
  @@index([tenantId, scheduledAt])
  @@index([tenantId, issueCaseId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([purpose(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([requestedById])
  @@index([decidedById])
}

/// Registro append-only de operaciones sensibles. PostgreSQL rechaza UPDATE,
/// DELETE y TRUNCATE; las capas de servicio redactan secretos antes de insertar.
model AuditEvent {
  id           String                 @id @default(cuid())
  tenantId     String
  mode         PoliticalOperationMode
  actorType    AuditActorType
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  outcome      AuditOutcome           @default(SUCCESS)
  requestId    String?
  sourceIpHash String?
  userAgent    String?
  before       Json?
  after        Json?
  metadata     Json?
  occurredAt   DateTime               @default(now())
  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  actorUser    User?                  @relation("AuditActor", fields: [actorUserId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, resourceType, resourceId, occurredAt])
  @@index([tenantId, actorUserId, occurredAt])
  @@index([tenantId, requestId])
}

/// Recibo durable e idempotente de una mutacion originada sin conectividad.
/// Solo conserva un HMAC del payload; nunca el documento, nombre u otra PII.
model OfflineSyncReceipt {
  id                String                   @id @default(cuid())
  tenantId          String
  actorUserId       String
  clientOperationId String                   @db.Uuid
  operationType     OfflineSyncOperationType
  payloadHmac       String                   @db.Char(64)
  /// SHA-256 canonico declarado y revalidado. Solo se exige para operaciones
  /// nuevas que lo incorporan; recibos VOTER/E14 previos permanecen intactos.
  payloadSha256     String?                  @db.Char(64)
  resourceType      String                   @db.VarChar(64)
  resourceId        String?
  capturedAt        DateTime
  receivedAt        DateTime                 @default(now())
  tenant            Tenant                   @relation(fields: [tenantId], references: [id])
  actorUser         User                     @relation("OfflineSyncActor", fields: [actorUserId, tenantId], references: [id, tenantId])

  @@unique([tenantId, clientOperationId])
  @@unique([id, tenantId])
  @@index([tenantId, actorUserId, receivedAt])
  @@index([tenantId, operationType, receivedAt])
}

/// Registered, short-lived capability for offline E-14 capture. The opaque
/// bearer value is never persisted; only its server-keyed HMAC is stored.
model OfflineE14CaptureGrant {
  id                   String                        @id @default(cuid())
  tenantId             String
  actorUserId          String
  operationProfileId   String
  tokenHmac            String                        @unique @db.Char(64)
  userAuthVersion      Int
  roleAtIssue          Role
  captureContext       WitnessCaptureContext
  issuedStage          PoliticalOperationStage
  electionDate         DateTime                      @db.Date
  votingStartDate      DateTime                      @db.Date
  votingEndDate        DateTime                      @db.Date
  electionWindowSha256 String                        @db.Char(64)
  issuedAt             DateTime                      @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?
  lastUsedAt           DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  tenant               Tenant                        @relation(fields: [tenantId], references: [id])
  actorUser            User                          @relation("OfflineE14GrantActor", fields: [actorUserId, tenantId], references: [id, tenantId])
  operationProfile     OperationProfile              @relation(fields: [operationProfileId, tenantId], references: [id, tenantId])
  allowedPlaces        OfflineE14CaptureGrantPlace[]

  @@unique([id, tenantId])
  @@index([tenantId, actorUserId, revokedAt, expiresAt], map: "OfflineE14Grant_tenant_actor_active_idx")
  @@index([tenantId, operationProfileId, expiresAt], map: "OfflineE14Grant_tenant_profile_expires_idx")
  @@index([tenantId, operationProfileId, votingStartDate, votingEndDate], map: "OfflineE14Grant_tenant_window_idx")
}

/// Exact polling-place/table scope frozen when an offline E-14 capability is
/// provisioned. Current access is still revalidated when it is consumed.
model OfflineE14CaptureGrantPlace {
  id                        String                 @id @default(cuid())
  tenantId                  String
  grantId                   String
  puestoId                  String
  expectedTables            Int
  sourceReleaseIdAtIssue    String?
  sourceLocationCodeAtIssue String?                @db.VarChar(32)
  votingDateAtIssue         DateTime?              @db.Date
  timeZoneAtIssue           String?                @db.VarChar(100)
  createdAt                 DateTime               @default(now())
  grant                     OfflineE14CaptureGrant @relation(fields: [grantId, tenantId], references: [id, tenantId], onDelete: Cascade)
  puesto                    PoliticalDivision      @relation(fields: [puestoId, tenantId], references: [id, tenantId])

  @@unique([tenantId, grantId, puestoId], map: "OfflineE14GrantPlace_tenant_grant_place_key")
  @@unique([id, tenantId])
  @@index([tenantId, puestoId, grantId], map: "OfflineE14GrantPlace_tenant_place_grant_idx")
}

