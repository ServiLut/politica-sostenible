diff --git a/lib/validate-ast.js b/lib/validate-ast.js
new file mode 100644
index 0000000000000000000000000000000000000000..f7bd6ac2895db69a8f4aa3b41964cbee8b7a77f2
--- /dev/null
+++ b/lib/validate-ast.js
@@ -0,0 +1,114 @@
+'use strict';
+
+// Local defense for GHSA-vfj7-8cjw-p6xm. Keep limits independent of caller
+// options so externally supplied ASTs cannot disable the recursion boundary.
+const MAX_DEPTH = 100;
+const MAX_NODES = 30000;
+
+const invalid = code => {
+  const error = new SyntaxError('Brace pattern exceeds the supported tree limits');
+  error.code = code;
+  return error;
+};
+
+const assertDepth = depth => {
+  if (depth > MAX_DEPTH) throw invalid('BRACES_MAX_DEPTH');
+};
+
+const validateNode = node => {
+  if (!node || typeof node !== 'object' || typeof node.type !== 'string') {
+    throw invalid('BRACES_INVALID_AST');
+  }
+  // Walkers coerce these fields. Arrays can recurse through toString even when
+  // the nodes tree itself is shallow, so accept only parser-produced scalars.
+  if (node.value !== undefined && typeof node.value !== 'string') {
+    throw invalid('BRACES_INVALID_AST');
+  }
+  for (const field of ['commas', 'ranges']) {
+    // Upstream increments an uninitialized comma counter in parentheses.
+    // Preserve its numeric NaN sentinel; it is not recursively coercible.
+    if (node.type === 'paren' && field === 'commas' && Number.isNaN(node[field])) continue;
+    if (node[field] !== undefined && (!Number.isSafeInteger(node[field]) || node[field] < 0)) {
+      throw invalid('BRACES_INVALID_AST');
+    }
+  }
+};
+
+const validateAst = ast => {
+  let scheduled = 1;
+  const reserve = count => {
+    if (scheduled + count > MAX_NODES) throw invalid('BRACES_MAX_NODES');
+    scheduled += count;
+  };
+  const checkedQueues = new WeakSet();
+  const inspectNode = node => {
+    validateNode(node);
+    if (node.queue === undefined || checkedQueues.has(node)) return;
+    checkedQueues.add(node);
+    if (!Array.isArray(node.queue)) throw invalid('BRACES_INVALID_AST');
+    reserve(1);
+    const pending = [{ value: node.queue, depth: 0, exit: false }];
+    const active = new WeakSet();
+    while (pending.length > 0) {
+      const frame = pending.pop();
+      const value = frame.value;
+      if (typeof value === 'string') continue;
+      if (!Array.isArray(value)) throw invalid('BRACES_INVALID_AST');
+      if (frame.exit) {
+        active.delete(value);
+        continue;
+      }
+      if (active.has(value)) throw invalid('BRACES_AST_CYCLE');
+      assertDepth(frame.depth);
+      reserve(value.length);
+      active.add(value);
+      pending.push({ value, depth: frame.depth, exit: true });
+      for (let i = value.length - 1; i >= 0; i--) {
+        pending.push({ value: value[i], depth: frame.depth + 1, exit: false });
+      }
+    }
+  };
+
+  // A subtree may legitimately retain ancestors. Bound the root's parent chain
+  // too, because expand walks it when a node is not a brace/root container.
+  const ancestors = new WeakSet();
+  let ancestor = ast;
+  let parentDepth = 0;
+  while (ancestor && typeof ancestor === 'object') {
+    inspectNode(ancestor);
+    if (ancestors.has(ancestor)) throw invalid('BRACES_AST_CYCLE');
+    ancestors.add(ancestor);
+    if (++parentDepth > MAX_DEPTH + 2) throw invalid('BRACES_MAX_DEPTH');
+    if (ancestor !== ast) reserve(1);
+    ancestor = ancestor.parent;
+  }
+  if (ancestor !== undefined && ancestor !== null) throw invalid('BRACES_INVALID_AST');
+
+  const pending = [{ node: ast, parent: null, depth: 0, exit: false }];
+  const active = new WeakSet();
+
+  while (pending.length > 0) {
+    const frame = pending.pop();
+    const node = frame.node;
+    inspectNode(node);
+    if (frame.exit) {
+      active.delete(node);
+      continue;
+    }
+    if (active.has(node)) throw invalid('BRACES_AST_CYCLE');
+    if (frame.depth > 0 && node.parent !== undefined && node.parent !== frame.parent) {
+      throw invalid('BRACES_INVALID_AST');
+    }
+    if (node.nodes === undefined) continue;
+    if (!Array.isArray(node.nodes)) throw invalid('BRACES_INVALID_AST');
+    assertDepth(frame.depth);
+    reserve(node.nodes.length);
+    active.add(node);
+    pending.push({ node, parent: frame.parent, depth: frame.depth, exit: true });
+    for (let index = node.nodes.length - 1; index >= 0; index--) {
+      pending.push({ node: node.nodes[index], parent: node, depth: frame.depth + 1, exit: false });
+    }
+  }
+};
+
+module.exports = { assertDepth, validateAst };
