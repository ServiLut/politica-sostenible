{
  "name": "politica-sostenible",
  "packageManager": "pnpm@10.28.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test:web-unit": "playwright test --config playwright.unit.config.ts",
    "test:e2e": "playwright test",
    "start": "turbo start",
    "install:all": "pnpm install",
    "api": "bruno open api-docs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "turbo": "^2.8.1"
  },
  "pnpm": {
    "overrides": {
      "ajv@8.17.1": "8.20.0",
      "body-parser": "2.3.0",
      "fast-uri@3.1.0": "3.1.5",
      "qs": "6.15.2"
    }
  }
}
