{
  "name": "politica-sostenible",
  "packageManager": "pnpm@10.28.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test:deploy": "node --test deploy/*.test.mjs",
    "test:web-unit": "playwright test --config playwright.unit.config.ts",
    "test:e2e": "playwright test",
    "start": "turbo start",
    "install:all": "pnpm install",
    "api": "bruno open api-docs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "turbo": "^2.8.1"
  },
  "pnpm": {
    "overrides": {
      "ajv@8.17.1": "8.20.0",
      "body-parser": "2.3.0",
      "deepmerge-ts@<8.0.0": "8.0.0",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "mysql2@<3.22.0": "3.24.3",
      "qs": "6.16.0"
    }
  }
}
